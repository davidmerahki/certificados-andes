PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/certificados
NODE_ENV=development

# Auth for admin endpoints
ADMIN_API_KEY=change-me-admin-key

# LearnWorlds
LEARNWORLDS_BASE_URL=https://yourschool.learnworlds.com/admin/api/v2
LEARNWORLDS_CLIENT_ID=
LEARNWORLDS_CLIENT_SECRET=
LEARNWORLDS_ACCESS_TOKEN=

# POK
POK_BASE_URL=https://api.pok.tech
POK_API_KEY=

# Scheduler (cron expression, default: nightly 02:00)
SYNC_CRON=0 2 * * *
SYNC_BATCH_SIZE=50
SYNC_CONCURRENCY=3
SIMULATION_MODE=true
